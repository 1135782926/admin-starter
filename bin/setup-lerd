#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

for tool in lerd curl openssl; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf '缺少 %s，请安装后重试。\n' "$tool" >&2
        exit 1
    fi
done

if ! dns_status=$(lerd dns:check); then
    printf '%s\n' "$dns_status" >&2
    exit 1
fi
tld=$(sed -nE 's/.*\*\.([a-z0-9-]+) resolves to.*/\1/p' <<< "$dns_status")
if [[ -z "$tld" && "$dns_status" == *localhost* ]]; then
    tld=localhost
fi
if [[ -z "$tld" ]]; then
    printf '无法识别 lerd 的本地域名后缀。\n%s\n' "$dns_status" >&2
    exit 1
fi

generated='# Generated by bin/setup-lerd'
for file in .lerd.local.yaml web/.lerd.local.yaml web/.env.lerd.local; do
    if [[ -e "$file" && "$(head -n 1 -- "$file")" != "$generated" ]]; then
        printf '请先检查已有配置 %s，初始化脚本需要使用该文件。\n' "$file" >&2
        exit 1
    fi
done

previous=''
if [[ -f .lerd.local.yaml ]]; then
    previous=$(sed -n 's/^  - "\([a-z0-9-]*\)"$/\1/p' .lerd.local.yaml)
fi
default=${previous:-backend}
read -r -p "请输入主域名 [$default.$tld]：" domain
domain=${domain:-$default}
label=${domain%.$tld}
if [[ ! "$label" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
    printf '请输入类似 backend 或 backend.%s 的本地域名。\n' "$tld" >&2
    exit 1
fi
if [[ -n "$previous" && "$label" != "$previous" ]]; then
    printf '这个目录已初始化为 %s.%s，请使用原域名重新运行。\n' "$previous" "$tld" >&2
    exit 1
fi

main_host=$label.$tld
api_host=api.$main_host
web_host=web.$main_host
lock_key=''
if [[ -f web/.env.lerd.local ]]; then
    lock_key=$(sed -n 's/^VITE_LOCK_ENCRYPT_KEY=//p' web/.env.lerd.local)
fi
lock_key=${lock_key:-$(openssl rand -hex 16)}

cat > .lerd.local.yaml <<EOF
$generated
domains:
  - "$label"
  - "api.$label"
EOF

cat > web/.lerd.local.yaml <<EOF
$generated
domains:
  - "web.$label"
EOF

cat > web/.env.lerd.local <<EOF
$generated
VITE_ACCESS_MODE=backend
VITE_BASE_URL=/
VITE_API_URL=/
VITE_API_PROXY_URL=http://lerd-nginx
VITE_LERD_API_HOST=$api_host
VITE_LERD_WEB_HOST=$web_host
VITE_LOCK_ENCRYPT_KEY=$lock_key
EOF
if [[ ! -f web/.env ]]; then
    cp -- web/.env.example web/.env
fi

# Use lerd's default setup steps and seed only the repeatable admin bootstrap data.
lerd setup --skip-open </dev/null
domains=$(lerd domain list)
if ! awk -v main="$main_host" -v api="$api_host" '
    $1 == main && $2 == "(primary)" { primary = 1 }
    $1 == api { alias_found = 1 }
    END { exit !(primary && alias_found) }
' <<< "$domains"; then
    printf '当前 Laravel 站点未取得 %s 和 %s，请检查域名冲突。\n' "$main_host" "$api_host" >&2
    exit 1
fi
for seeder in AdminManagementMenuSeeder AttachmentManagementMenuSeeder AdminUserSeeder; do
    lerd php artisan db:seed --class="$seeder" --no-interaction
done

(
    cd web
    # Podman builds cannot reach a proxy listening on the host's loopback.
    for variable in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do
        proxy=${!variable-}
        if [[ "${proxy#*://}" =~ ^(localhost|127\.[0-9.]+|\[::1\])([:/]|$) ]]; then
            unset "$variable"
        fi
    done
    lerd link
    if ! lerd group list | awk -v main="$main_host" -v web="$web_host" '
        /^[^[:space:]]/ { in_group = ($NF == "(" main ")") }
        in_group && $2 == "->" && $3 == web { found = 1 }
        END { exit !found }
    '; then
        lerd group add "$main_host" web
    fi
)

printf '等待 Vite 安装依赖并启动…\n'
if ! curl --noproxy '*' --fail --silent --max-time 5 --retry 300 --retry-max-time 600 \
    --retry-all-errors --retry-delay 2 "http://$web_host/@vite/client" >/dev/null; then
    printf 'Vite 未就绪，请用 podman ps -a 和 podman logs 检查前端容器。\n' >&2
    exit 1
fi
for host in "$api_host" "$web_host"; do
    status=$(curl --noproxy '*' --silent --show-error --max-time 10 \
        --header 'Accept: application/json' --output /dev/null --write-out '%{http_code}' \
        "http://$host/api/v1/admin/me")
    if [[ "$status" != 401 ]]; then
        printf '%s 的 API 检查返回 HTTP %s，预期为 401。\n' "$host" "$status" >&2
        exit 1
    fi
done
printf '后台 http://%s/\nAPI  http://%s\n' "$web_host" "$api_host"
