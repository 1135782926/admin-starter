# 复制为 .env 后配置本地开发环境
VITE_VERSION=3.0.2
VITE_PORT=3006
VITE_BASE_URL=/
VITE_ACCESS_MODE=backend
VITE_WITH_CREDENTIALS=false
VITE_OPEN_ROUTE_INFO=false

# 本地填写随机字符串；VITE_ 变量会进入前端构建产物
VITE_LOCK_ENCRYPT_KEY=

# Laravel 开发代理；生产环境默认同源部署 /api
VITE_API_URL=/
VITE_API_PROXY_URL=http://localhost:8000
VITE_DROP_CONSOLE=false

# 设置为 Laravel 的 REVERB_APP_KEY 以启用实时通知。
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
